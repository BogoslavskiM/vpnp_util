#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_PATH="$SCRIPT_DIR/vpnp"
COMPLETION_TARGET="$SCRIPT_DIR/_vpnp"

choose_bin_dir() {
  if [[ -n "${VPN_INSTALL_BIN_DIR:-}" ]]; then
    printf '%s\n' "$VPN_INSTALL_BIN_DIR"
    return 0
  fi

  local candidate
  for candidate in "/usr/local/bin" "/opt/homebrew/bin" "$HOME/.local/bin" "$HOME/bin"; do
    case ":$PATH:" in
      *":$candidate:"*)
        printf '%s\n' "$candidate"
        return 0
        ;;
    esac
  done

  printf '%s\n' "$HOME/.local/bin"
}


choose_completion_dir() {
  if [[ -n "${VPN_INSTALL_COMPLETION_DIR:-}" ]]; then
    printf '%s\n' "$VPN_INSTALL_COMPLETION_DIR"
    return 0
  fi

  local candidate
  for candidate in "/usr/local/share/zsh/site-functions" "/opt/homebrew/share/zsh/site-functions" "$HOME/.zsh/completions"; do
    if [[ -d "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  printf '%s\n' "$HOME/.zsh/completions"
}

BIN_DIR="$(choose_bin_dir)"
LINK_PATH="$BIN_DIR/vpnp"
LEGACY_LINK_PATH="$BIN_DIR/vpn"
COMPLETION_DIR="$(choose_completion_dir)"
COMPLETION_LINK="$COMPLETION_DIR/_vpnp"

if [[ ! -x "$TARGET_PATH" ]]; then
  echo "vpnp command is not executable." >&2
  echo "Run: chmod +x vpnp" >&2
  exit 1
fi

mkdir -p "$BIN_DIR"
if ! ln -sfn "$TARGET_PATH" "$LINK_PATH" 2>/dev/null; then
  echo "Could not install the global vpnp command." >&2
  echo "Try a writable global bin directory:" >&2
  echo "  VPN_INSTALL_BIN_DIR=\"\$HOME/.local/bin\" ./install" >&2
  echo >&2
  echo "Or install into /usr/local/bin with elevated permissions:" >&2
  echo "  sudo VPN_INSTALL_BIN_DIR=/usr/local/bin ./install" >&2
  exit 2
fi

if [[ -L "$LEGACY_LINK_PATH" ]]; then
  legacy_target="$(readlink "$LEGACY_LINK_PATH")"
  if [[ "$legacy_target" == "$SCRIPT_DIR/vpn" || "$legacy_target" == "$TARGET_PATH" ]]; then
    rm "$LEGACY_LINK_PATH" 2>/dev/null || true
  fi
fi

mkdir -p "$COMPLETION_DIR"
if [[ -f "$COMPLETION_TARGET" ]]; then
  if ln -sfn "$COMPLETION_TARGET" "$COMPLETION_LINK" 2>/dev/null; then
    echo "Shell completions installed."
  else
    echo "Could not install shell completions." >&2
    echo "Try: sudo VPN_INSTALL_COMPLETION_DIR=$COMPLETION_DIR ./install" >&2
  fi
fi

echo "Global vpnp command installed."
echo "If Tab still shows files, restart the terminal or run: autoload -Uz compinit; compinit"

case ":$PATH:" in
  *":$BIN_DIR:"*)
    echo "Try: vpnp help"
    ;;
  *)
    echo
    echo "Add the install directory to PATH for this terminal session:"
    echo "  export PATH=\"$BIN_DIR:\$PATH\""
    echo
    echo "Then try:"
    echo "  vpnp help"
    ;;
esac
