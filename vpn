#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SOURCE_PATH="$LINK_TARGET"
  else
    SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  vpn up
  vpn down
  vpn status
  vpn ip
  eval "$(vpn env)"
  vpn log [lines]
  vpn google [browser-args...]
  vpn yandex [browser-args...]
  vpn update-config /path/to/wireguard.conf
  vpn uninstall
  vpn help
EOF
}

uninstall_global_command() {
  target="$SCRIPT_DIR/vpn"
  removed=0
  seen_dirs=":"

  candidate_dirs=()
  IFS=":" read -r -a path_dirs <<< "$PATH"
  for dir in "${path_dirs[@]}" "/usr/local/bin" "/opt/homebrew/bin" "$HOME/.local/bin" "$HOME/bin"; do
    [[ -z "$dir" ]] && continue
    case "$seen_dirs" in
      *":$dir:"*) continue ;;
    esac
    seen_dirs="${seen_dirs}${dir}:"
    candidate_dirs+=("$dir")
  done

  for dir in "${candidate_dirs[@]}"; do
    link="$dir/vpn"
    [[ -L "$link" ]] || continue

    link_target="$(readlink "$link")"
    if [[ "$link_target" != /* ]]; then
      link_target="$(cd -P "$dir" && cd -P "$(dirname "$link_target")" && pwd)/$(basename "$link_target")"
    fi

    if [[ "$link_target" == "$target" ]]; then
      if rm "$link" 2>/dev/null; then
        echo "Global vpn command removed."
        removed=1
      else
        echo "Could not remove the global vpn command." >&2
        echo "Try: sudo rm \"$link\"" >&2
        exit 1
      fi
    fi
  done

  if [[ "$removed" -eq 0 ]]; then
    echo "No global vpn command for this project was found."
  fi
}

if [[ "$#" -eq 0 ]]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  up)
    exec "$SCRIPT_DIR/start-work-vpn-proxy.sh" "$@"
    ;;
  down)
    exec "$SCRIPT_DIR/stop-work-vpn-proxy.sh" "$@"
    ;;
  status)
    exec "$SCRIPT_DIR/status-work-vpn-proxy.sh" "$@"
    ;;
  ip)
    exec "$SCRIPT_DIR/check-ip.sh" "$@"
    ;;
  env)
    CONFIG_FILE="${VPN_SPLIT_CONFIG:-$SCRIPT_DIR/vpn.env}"
    if [[ ! -f "$CONFIG_FILE" ]]; then
      echo "VPN is not configured yet. Run: vpn update-config /path/to/wireguard.conf" >&2
      exit 2
    fi

    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    : "${VPN_PROXY_SCHEME:=socks5}"
    : "${VPN_PROXY_HOST:=127.0.0.1}"
    : "${VPN_PROXY_PORT:=1080}"
    : "${VPN_TERMINAL_PROXY_URL:=socks5h://${VPN_PROXY_HOST}:${VPN_PROXY_PORT}}"
    : "${NO_PROXY:=localhost,127.0.0.1,::1,.local}"

    printf 'export VPN_MODE=%q\n' "1"
    printf 'export ALL_PROXY=%q\n' "$VPN_TERMINAL_PROXY_URL"
    printf 'export all_proxy=%q\n' "$VPN_TERMINAL_PROXY_URL"
    printf 'export HTTPS_PROXY=%q\n' "$VPN_TERMINAL_PROXY_URL"
    printf 'export https_proxy=%q\n' "$VPN_TERMINAL_PROXY_URL"
    printf 'export HTTP_PROXY=%q\n' "$VPN_TERMINAL_PROXY_URL"
    printf 'export http_proxy=%q\n' "$VPN_TERMINAL_PROXY_URL"
    printf 'export NO_PROXY=%q\n' "$NO_PROXY"
    printf 'export no_proxy=%q\n' "$NO_PROXY"
    printf 'export GIT_SSH_COMMAND=%q\n' "ssh -o ProxyCommand='nc -x ${VPN_PROXY_HOST}:${VPN_PROXY_PORT} -X 5 %h %p'"
    ;;
  log)
    lines="${1:-80}"
    exec tail -n "$lines" "$SCRIPT_DIR/runtime/sing-box-work.log"
    ;;
  google)
    "$SCRIPT_DIR/start-work-vpn-proxy.sh" >/dev/null
    exec "$SCRIPT_DIR/google-vpn.sh" "$@"
    ;;
  yandex)
    "$SCRIPT_DIR/start-work-vpn-proxy.sh" >/dev/null
    exec "$SCRIPT_DIR/yandex-vpn.sh" "$@"
    ;;
  update-config|update_config)
    exec "$SCRIPT_DIR/update_config" "$@"
    ;;
  uninstall)
    uninstall_global_command
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
