#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SOURCE_PATH="$LINK_TARGET"
  else
    SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  vpnp up [--force]
  vpnp down
  vpnp status
  vpnp ip
  vpnp shell
  vpnp log [lines]
  vpnp google [browser-args...]
  vpnp yandex [browser-args...]
  vpnp matlab [matlab-args...]
  vpnp update-config /path/to/wireguard.conf
  vpnp uninstall
  vpnp help
EOF
}

uninstall_global_command() {
  target="$SCRIPT_DIR/vpnp"
  completion_target="$SCRIPT_DIR/_vpnp"
  removed=0
  seen_dirs=":"

  candidate_dirs=()
  IFS=":" read -r -a path_dirs <<< "$PATH"
  for dir in "${path_dirs[@]}" "/usr/local/bin" "/opt/homebrew/bin" "$HOME/.local/bin" "$HOME/bin"; do
    [[ -z "$dir" ]] && continue
    case "$seen_dirs" in
      *":$dir:"*) continue ;;
    esac
    seen_dirs="${seen_dirs}${dir}:"
    candidate_dirs+=("$dir")
  done

  for dir in "${candidate_dirs[@]}"; do

    completion_link="$dir/_vpnp"
    if [[ -L "$completion_link" ]]; then
      completion_link_target="$(readlink "$completion_link")"
      if [[ "$completion_link_target" != /* ]]; then
        completion_link_target="$(cd -P "$dir" && cd -P "$(dirname "$completion_link_target")" && pwd)/$(basename "$completion_link_target")"
      fi
      if [[ "$completion_link_target" == "$completion_target" ]]; then
        rm "$completion_link" 2>/dev/null || true
      fi
    fi
    link="$dir/vpnp"
    [[ -L "$link" ]] || continue

    link_target="$(readlink "$link")"
    if [[ "$link_target" != /* ]]; then
      link_target="$(cd -P "$dir" && cd -P "$(dirname "$link_target")" && pwd)/$(basename "$link_target")"
    fi

    if [[ "$link_target" == "$target" ]]; then
      if rm "$link" 2>/dev/null; then
        echo "Global vpnp command removed."
        removed=1
      else
        echo "Could not remove the global vpnp command." >&2
        echo "Try: sudo rm \"$link\"" >&2
        exit 1
      fi
    fi
  done

  for dir in "/usr/local/share/zsh/site-functions" "/opt/homebrew/share/zsh/site-functions" "$HOME/.zsh/completions"; do
    completion_link="$dir/_vpnp"
    [[ -L "$completion_link" ]] || continue

    completion_link_target="$(readlink "$completion_link")"
    if [[ "$completion_link_target" != /* ]]; then
      completion_link_target="$(cd -P "$dir" && cd -P "$(dirname "$completion_link_target")" && pwd)/$(basename "$completion_link_target")"
    fi

    if [[ "$completion_link_target" == "$completion_target" ]]; then
      rm "$completion_link" 2>/dev/null || true
    fi
  done

  if [[ "$removed" -eq 0 ]]; then
    echo "No global vpnp command for this project was found."
  fi
}

load_proxy_shell_config() {
  CONFIG_FILE="${VPN_SPLIT_CONFIG:-$SCRIPT_DIR/vpn.env}"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "VPN is not configured yet. Run: vpnp update-config /path/to/wireguard.conf" >&2
    exit 2
  fi

  # shellcheck source=/dev/null
  source "$CONFIG_FILE"

  : "${VPN_PROXY_SCHEME:=socks5}"
  : "${VPN_PROXY_HOST:=127.0.0.1}"
  : "${VPN_PROXY_PORT:=1080}"
  : "${VPN_TERMINAL_PROXY_URL:=socks5h://${VPN_PROXY_HOST}:${VPN_PROXY_PORT}}"
  : "${SING_BOX_LAUNCH_LABEL:=local.makar.work-vpn-singbox}"
  : "${NO_PROXY:=localhost,127.0.0.1,::1,.local}"
}

start_proxy_for_matlab() {
  load_proxy_shell_config

  if launchctl print "gui/$(id -u)/$SING_BOX_LAUNCH_LABEL" >/dev/null 2>&1; then
    "$SCRIPT_DIR/start-work-vpn-proxy.sh" --force
  else
    "$SCRIPT_DIR/start-work-vpn-proxy.sh"
  fi
}

start_proxy_shell() {
  "$SCRIPT_DIR/start-work-vpn-proxy.sh"
  load_proxy_shell_config

  export VPN_MODE="1"
  export ALL_PROXY="$VPN_TERMINAL_PROXY_URL"
  export all_proxy="$VPN_TERMINAL_PROXY_URL"
  export HTTPS_PROXY="$VPN_TERMINAL_PROXY_URL"
  export https_proxy="$VPN_TERMINAL_PROXY_URL"
  export HTTP_PROXY="$VPN_TERMINAL_PROXY_URL"
  export http_proxy="$VPN_TERMINAL_PROXY_URL"
  export NO_PROXY
  export no_proxy="$NO_PROXY"
  export GIT_SSH_COMMAND="ssh -o ProxyCommand='nc -x ${VPN_PROXY_HOST}:${VPN_PROXY_PORT} -X 5 %h %p'"

  echo "VPN proxy is enabled for this terminal."
  echo "Type exit to leave the VPN shell."
  exec "${SHELL:-/bin/zsh}" -l
}

if [[ "$#" -eq 0 ]]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  up)
    exec "$SCRIPT_DIR/start-work-vpn-proxy.sh" "$@"
    ;;
  down)
    exec "$SCRIPT_DIR/stop-work-vpn-proxy.sh" "$@"
    ;;
  status)
    exec "$SCRIPT_DIR/status-work-vpn-proxy.sh" "$@"
    ;;
  ip)
    exec "$SCRIPT_DIR/check-ip.sh" "$@"
    ;;
  shell)
    start_proxy_shell
    ;;
  log)
    lines="${1:-80}"
    exec tail -n "$lines" "$SCRIPT_DIR/runtime/sing-box-work.log"
    ;;
  google)
    "$SCRIPT_DIR/start-work-vpn-proxy.sh"
    exec "$SCRIPT_DIR/google-vpn.sh" "$@"
    ;;
  yandex)
    "$SCRIPT_DIR/start-work-vpn-proxy.sh"
    exec "$SCRIPT_DIR/yandex-vpn.sh" "$@"
    ;;
  matlab)
    start_proxy_for_matlab
    exec "$SCRIPT_DIR/matlab-vpn.sh" "$@"
    ;;
  update-config|update_config)
    exec "$SCRIPT_DIR/update_config" "$@"
    ;;
  uninstall)
    uninstall_global_command
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
