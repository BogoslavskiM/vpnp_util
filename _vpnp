#compdef vpnp

local -a commands
commands=(
  'up:поднять локальный VPN SOCKS-прокси'
  'down:остановить VPN SOCKS-прокси'
  'status:показать состояние VPN-прокси'
  'ip:сравнить обычный IP и IP через прокси'
  'shell:открыть shell через VPN-прокси'
  'log:показать лог sing-box'
  'google:открыть Google Chrome через VPN-прокси'
  'yandex:открыть Yandex Browser через VPN-прокси'
  'matlab:открыть MATLAB через VPN-прокси'
  'update-config:обновить WireGuard-конфиг'
  'uninstall:удалить глобальную команду vpnp'
  'help:показать справку'
)

_arguments -C \
  '1:команда:->command' \
  '*::аргумент:->argument'

case "$state" in
  command)
    _describe -t commands 'команды vpnp' commands
    ;;
  argument)
    case "$words[2]" in
      update-config)
        _files
        ;;
      up)
        _arguments '--force[перезапустить уже загруженный сервис]'
        ;;
      log)
        _guard '[0-9]#' 'количество строк'
        ;;
      google|yandex)
        _message 'аргументы браузера или URL'
        ;;
      matlab)
        _message 'аргументы MATLAB'
        ;;
      *)
        _message 'у этой команды нет обязательных аргументов'
        ;;
    esac
    ;;
esac
